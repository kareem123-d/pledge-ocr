APP_NAME=loan-pledge-ocr-api
API_PREFIX=/api/v1
LOG_LEVEL=INFO
# Comma-separated list of frontend addresses allowed to call the API
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=15
MAX_IMAGE_PIXELS=40000000
MAX_PDF_PAGES=10
OCR_LANG=en
OCR_USE_ANGLE_CLS=true
OCR_PRELOAD=true
OCR_MAX_CONCURRENCY=1
OCR_QUEUE_MAX=6
OCR_QUEUE_TIMEOUT=120
OCR_MAX_SIDE=2500
OCR_MIN_SIDE=1000
OCR_DENOISE=false
OCR_REFINE=true
OCR_REFINE_MAX_CROPS=40
OCR_AUTO_ROTATE=true
OCR_DESKEW=true
PDF_RENDER_DPI=200
PDF_MIN_TEXT_CHARS=30
ENABLE_TROCR=false
TROCR_MODEL=microsoft/trocr-small-handwritten
FIELD_MIN_OCR_CONFIDENCE=0.90
FIELD_MIN_MATCH_CONFIDENCE=0.75
MANDATORY_FIELDS=customerName,bankName,loanAccountNumber,pledgeNumber,loanAmount,loanDate,dueDate,branchName,phoneNumber,interestRate,tenure,netWeight,address
